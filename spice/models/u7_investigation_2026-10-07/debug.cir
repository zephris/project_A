.meas tran debug_4 FIND v(ilim) AT=29m
.meas tran debug_5 FIND v(xswitch.powerok) AT=29m
.meas tran debug_6 FIND v(xswitch.u1_vccok) AT=29m
.meas tran debug_7 FIND v(xswitch.u1_enok) AT=29m
.meas tran debug_8 FIND v(xswitch.u2_gate) AT=29m
.meas tran debug_9 FIND v(xswitch.gate_off) AT=29m
.meas tran debug_10 FIND v(xswitch.ilim_int) AT=29m
.meas tran debug_11 FIND v(xswitch.u1_n16726884) AT=29m
.meas tran debug_12 FIND v(xswitch.u1_n16726205) AT=29m
.end
