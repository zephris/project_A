(version 1)
# AGENTS.md: D1-D16 intentionally sit inside matching switch courtyards for light transmission.
# These exceptions cover courtyard overlap only; copper, drills and all other pairs remain checked.
(rule "Intentional SW1 LED optical overlap"
 (condition "(A.Reference == 'SW1' && B.Reference == 'D1') || (A.Reference == 'D1' && B.Reference == 'SW1')")
 (constraint courtyard_clearance (min -1mm)))
(rule "Intentional SW2 LED optical overlap"
 (condition "(A.Reference == 'SW2' && B.Reference == 'D2') || (A.Reference == 'D2' && B.Reference == 'SW2')")
